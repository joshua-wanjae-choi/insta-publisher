# Instagram Graph API Settings
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id
GRAPH_API_ACCESS_TOKEN=your_access_token_here
GRAPH_API_VERSION=v21.0

# 1. Web Dashboard Admin Login
ADMIN_USER=admin
ADMIN_PASS=your_strong_password_here

# 2. Generator 전용 업로드 API Bearer Token
UPLOAD_API_TOKEN=gen_secret_token_change_this

# 3. Server Public URL (Caddy 도메인)
PUBLIC_BASE_URL=https://insta.yourdomain.com
PORT=8080
